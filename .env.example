# Copy to .env and fill in. Never commit .env.
# Required: a free OpenRouter key (https://openrouter.ai/keys). Free models allow 50 requests a day;
# buying 10 credits once raises that to 1,000 free-model requests a day (the credits are not spent).
OPENROUTER_API_KEY=

# Optional overrides
# AGENT_MODEL=google/gemma-4-31b-it:free
# AGENT_SMALL_MODEL=google/gemma-4-26b-a4b-it:free     # used by the LLM judge
# AGENT_CACHE=1                                         # 0 = always call the model
# RAFEEQ_MAX_STEPS=8  RAFEEQ_MAX_COST=0.05  RAFEEQ_MAX_RUN_TOKENS=60000

# Models used for the recorded results (the course default Gemma was rate-limited upstream on the day):
# AGENT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# AGENT_SMALL_MODEL=poolside/laguna-s-2.1:free
# AGENT_FALLBACKS=poolside/laguna-s-2.1:free,nvidia/nemotron-3.5-super-vl:free
